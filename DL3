#include <stdio.h>
#include <math.h>
#define EXP 0.001
void fx(int n, int a[]) {
    int i;
    
    printf("Nhap he so mu:\n");
    for (i = 0; i <= n; i++) {
        printf("a[%d] = ", i);
        scanf("%d", &a[i]);
    }
    
    printf("f(x) = ");
    int first_term = 1; 
    int b = n;          
    
    for (i = 0; i <= n; i++) {
        if (a[i] == 0) {
            b--;
            continue; 
        }
        if (first_term) {   
            if (a[i] < 0) printf("-");
            first_term = 0; 
        } else {
            if (a[i] > 0) printf(" + ");
            else printf(" - ");
        }
        int abs_coeff = a[i] < 0 ? -a[i] : a[i];   
        
        if (b == 0) {           
            printf("%d", abs_coeff);
        } else {          
            if (abs_coeff != 1) {
                printf("%d*", abs_coeff);   
            }

            if (b == 1) {
                printf("x");      
            } else {
                printf("x^%d", b); 
            }
        }
        b--;
    }
    
    if (first_term == 1) {
        printf("0");
    }
    printf("\n");
}

int main(){
	float m1,m2;
	int a[100];
	int i,n;
	printf("Nhap co so mu :"); scanf("%d",&n);
	fx(n,a);
	m1=fabs(a[1]);
	m2=fabs(a[0]);
	for (i = 1; i <=n ;i++){
		if(m1 <= fabs(a[i])){
			m1 = fabs(a[i]);
		}
	}
	for (i = 0;i <= n-1;i++){
		if(m2 <= fabs(a[i])){
			m2 = fabs(a[i]);
		}
	}
	float x1,x2;
	x1 = fabs(a[n]/(m2+fabs(a[n])));
	x2 = 1 + (m1/fabs(a[0])) ;
	printf("Vay khoang nghiem cua phuong trinh la (%.2f , %.2f)",x1,x2);
	return 0;
}
