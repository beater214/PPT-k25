#include <stdio.h>
#include <math.h>


double pt1(double x){
	return cbrt(x + 1.0);
}
double pt2(double x){
	return cos(x);
}
double pt3(double x){
	return exp(x) / 3.0;
}
void phuong_phap_lap(double (*g_func)(double), double x0 ,double epsilon){
	double x = x0 , y , hieu_hai_nghiem;
	int so_lan_lap = 1, max_lap = 100;
	
	printf("\n%-10s  | %-15s | %-15s | %-15s\n","Lan lap","x","g(x)","Sai so");
	printf("-------------------------------------------------------\n");

	
do {
	y = g_func(x);
    hieu_hai_nghiem = fabs ( y - x );
    
    printf("%-10d | %-15.6lf | %-15.6lf | %-15.6lf\n", so_lan_lap , x , y ,hieu_hai_nghiem);
    
    x = y; 
    so_lan_lap++;
}while ( hieu_hai_nghiem >= epsilon && so_lan_lap <= max_lap);

if ( so_lan_lap > max_lap){
	printf("Qua so lan lap cho phep,hay nhap lai\n");
} 
else{
	printf("\n=> Nghiem xap xi la: x = %.6lf\n", x);
}
}

int main() {

    int lua_chon;
    double x0, epsilon;

    printf("=== CHUONG TRINH TIM NGHIEM BANG PHUONG PHAP LAP ===\n");
    printf("1. x^3 - x - 1 = 0    (g(x) = cbrt(x + 1))\n");
    printf("2. x - cos(x) = 0     (g(x) = cos(x))\n");
    printf("3. e^x - 3x = 0       (g(x) = e^x / 3)\n");
    printf("Chon phuong trinh (1-3): ");
    
    if (scanf("%d", &lua_chon) != 1 || lua_chon < 1 || lua_chon > 3) {
        printf("Lua chon khong hop le!\n");
        return 1;
    }

    printf("Nhap gia tri bat dau x0: ");
    scanf("%lf", &x0);
    
    printf("Nhap sai so epsilon (vd: 0.001): ");
    scanf("%lf", &epsilon);

   
    switch (lua_chon) {
        case 1:
            phuong_phap_lap(pt1, x0, epsilon);
            break;
        case 2:
            phuong_phap_lap(pt2, x0, epsilon);
            break;
        case 3:
            phuong_phap_lap(pt3, x0, epsilon);
            break;
    }

    return 0;
}








