    		printf("Lua chon khong hop le\n");
    		fflush(stdin);
		}
		if (lc == 0) break;
		
		printf("\n");
    	if(lc == 1){
    		double res = hoocne(a, n, c);
    		printf("P(%g) = %g\n",c, res);
    	}
    	else if(lc == 2){
    		hoocnetq(a,b,n,c);
    		output(b,n,c);
    	}
