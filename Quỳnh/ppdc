    char tiep_tuc;
    do{
    printf("1. Phuong trinh mu \n");
		printf("2.f(x)= e^x - 3x \n");
		printf("3.f(x)= sin(x) - cos(x) \n");
    printf("Chon phuong trinh can giai: ");
    int choice;
    scanf("%d", &choice);
    if (choice == 1) {
        if (!input()) {
            return 1;
        }
        day_cung();
    } else if (choice == 2) {
        f = f2;
        day_cung();
    } else if (choice == 3) {
        f = f3;
        day_cung();
    } else {
        printf("Lua chon khong hop le!\n");
    }
    printf("Ban co muon tiep tuc khong? (y/n): ");
    scanf(" %c", &tiep_tuc);
} while(tiep_tuc=='y' || tiep_tuc=='Y');
    return 0;}
