#include <stdio.h>
#include <math.h>

#define N 100
int k;
double s[N];
double (*f)(double);
int input() {
    printf("Nhap bac phuong trinh:");
    if (scanf("%d", &k) != 1) {
        printf("Dinh dang khong hop le!\n");
        return 0;
    }
    if (k >= N || k < 0) {
        printf("Bac khong hop le!\n");
        return 0;
    }
    int i;
    for (i = k; i >= 0; i--) {
        printf("s[%d] = ", i);
        if (scanf("%lf", &s[i]) != 1) {
            printf("Dinh dang khong hop le!\n");
            return 0;
        }
    }
    printf("Phuong trinh : ");
    for (i = k; i >= 0; i--) {
        if (s[i] == 0) continue;
        if (i != k && s[i] > 0) printf(" + ");
        if ((i != k && s[i] < 0) || (i == k && s[i] < 0)) printf(" - ");
        if ((fabs(s[i]) == 1) && i > 0) {
            printf("x^%d", i);
        } else if (i >= 1) {
            printf("%lfx^%d", fabs(s[i]), i);
        } else {
            printf("%lf", fabs(s[i]));
        }
    }
    printf(" = 0\n");
    return 1;
}
double f1(double x) {

    double sum = 0;
    for (int i = k; i >= 0; i--) {
        sum += s[i] * pow(x, i);
    }
    return sum;
}
double f2(double x) {
    return exp(x) - 3*x;}
double f3(double x) {
    return sin(x) - cos(x);
}
void day_cung() {
    double a, b, x;
    printf("\nNhap khoang nghiem can tim (a b): ");
    scanf("%lf %lf", &a, &b);
    printf("Nhap sai so: ");
    double e;
    scanf("%lf", &e);
    if (f(a) * f(b) >= 0) {
        printf("Khong co nghiem trong khoang da cho.\n");
        return;
    }
    int j = 1;
    do {
        x = a - (f(a) * (b - a)) / (f(b) - f(a));
        if (f(a) * f(x) < 0) {
            b = x;
        } else {
            a = x;
        }
        printf("Buoc %d: x = %lf  Sai so = %lf\n", j, x, fabs(f(x)));
        j++;
        if (j > 1000) {
            printf("Khong hoi tu!\n");
            return;
        }
    } while (fabs(f(x)) > e);
    printf("Nghiem gan dung la: %lf\n", x);
}
